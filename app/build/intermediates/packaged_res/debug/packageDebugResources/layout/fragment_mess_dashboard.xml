<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    tools:context=".ui.mess.dashboard.MessDashboardFragment">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- ════════════════════════════════════ -->
    <!--     AppBarLayout — collapses on scroll   -->
    <!-- ════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_page"
        app:elevation="0dp">

        <!-- ════════════ HEADER BANNER ════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_admin_header_banner"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="32dp"
            android:paddingBottom="20dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <!-- Row 1: Icon + Mess Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_surface"
                    android:backgroundTint="#33FFFFFF">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_restaurant"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ADMIN PANEL"
                        android:textSize="9sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:textColor="#99FFFFFF" />

                    <TextView
                        android:id="@+id/text_mess_dashboard_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mess Name"
                        android:textSize="22sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp"
                        tools:text="Kartik Mess" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#33FFFFFF" />

            <!-- Row 2: Date (left) + Timer pill (right) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layout_date_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/layout_deadline_container"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#CCFFFFFF" />

                    <TextView
                        android:id="@+id/text_mess_dashboard_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Sunday, 1 Jan 2025"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textColor="#CCFFFFFF"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Friday, June 26, 2026" />
                </LinearLayout>

                <!-- Timer pill -->
                <LinearLayout
                    android:id="@+id/layout_deadline_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_deadline_pill"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_schedule"
                        app:tint="#FACC15" />

                    <TextView
                        android:id="@+id/text_dashboard_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="--:--:--"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textColor="#FACC15"
                        tools:text="02:30:00" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ════════════ SCROLLABLE CONTENT ════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="100dp">

                <!-- ═══════════════════════════════ -->
                <!--   MESS CONDITION CARD          -->
                <!-- ═══════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    style="@style/Profound.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Section header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_rounded_card_surface"
                                android:backgroundTint="@color/brand_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MESS CONDITION"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/inter"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_caption"
                                    android:letterSpacing="0.06" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Update availability for students"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inter"
                                    android:textColor="@color/text_sub"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <!-- Current condition badge -->
                            <TextView
                                android:id="@+id/text_current_condition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Not Set"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:textColor="@color/text_caption"
                                android:background="@drawable/bg_rounded_card_surface"
                                android:backgroundTint="@color/neutral_100"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp" />
                        </LinearLayout>

                        <!-- 2×2 Condition buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp"
                                android:weightSum="2">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_condition_full"
                                    style="@style/Profound.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:text="FULL"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/semantic_error"
                                    app:strokeColor="@color/semantic_error"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_warning"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/semantic_error" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_condition_half"
                                    style="@style/Profound.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="HALF"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/semantic_warning"
                                    app:strokeColor="@color/semantic_warning"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_half_filled"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/semantic_warning" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_condition_empty"
                                    style="@style/Profound.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="6dp"
                                    android:text="EMPTY"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/semantic_success"
                                    app:strokeColor="@color/semantic_success"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_check_circle"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/semantic_success" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_condition_not_conform"
                                    style="@style/Profound.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="NOT CONFIRMED"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/neutral_500"
                                    app:strokeColor="@color/neutral_400"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_info"
                                    app:iconSize="16dp"
                                    app:iconTint="@color/neutral_500" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Reset button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_all_attendance"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="RESET ALL ATTENDANCE"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_restore"
                            app:iconTint="@color/brand_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════ -->
                <!--   TODAY'S ATTENDANCE CARD       -->
                <!-- ═══════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    style="@style/Profound.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="18dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_rounded_card_surface"
                                android:backgroundTint="@color/brand_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:text="TODAY'S ATTENDANCE"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:textColor="@color/text_caption"
                                android:letterSpacing="0.06" />

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_circle_surface"
                                android:backgroundTint="@color/brand_primary_light">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_group"
                                    app:tint="@color/brand_primary" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Total students big number -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/text_total_students"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/text_heading"
                                    android:textSize="44sp"
                                    android:fontFamily="@font/poppins"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Students"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/inter"
                                    android:textColor="@color/text_caption" />
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="60dp"
                                android:background="@color/neutral_200"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp" />

                            <!-- Lunch IN/OUT -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <FrameLayout
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:background="@drawable/bg_rounded_card_surface"
                                        android:backgroundTint="@color/semantic_success_bg"
                                        android:layout_marginEnd="6dp">
                                        <ImageView
                                            android:layout_width="13dp"
                                            android:layout_height="13dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_lunch_dining"
                                            app:tint="@color/state_success" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Lunch"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/inter"
                                        android:textColor="@color/text_caption" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/text_lunch_in_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:fontFamily="@font/poppins"
                                        android:textStyle="bold"
                                        android:textColor="@color/state_success" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" / "
                                        android:textSize="16sp"
                                        android:fontFamily="@font/inter"
                                        android:textColor="@color/text_caption" />

                                    <TextView
                                        android:id="@+id/text_lunch_out_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:fontFamily="@font/poppins"
                                        android:textStyle="bold"
                                        android:textColor="@color/semantic_error" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="IN"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/inter"
                                        android:textStyle="bold"
                                        android:textColor="@color/state_success" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="   OUT"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/inter"
                                        android:textStyle="bold"
                                        android:textColor="@color/semantic_error" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="60dp"
                                android:background="@color/neutral_200"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp" />

                            <!-- Dinner IN/OUT -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginBottom="4dp">

                                    <FrameLayout
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:background="@drawable/bg_rounded_card_surface"
                                        android:backgroundTint="@color/brand_primary_light"
                                        android:layout_marginEnd="6dp">
                                        <ImageView
                                            android:layout_width="13dp"
                                            android:layout_height="13dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_dinner_dining"
                                            app:tint="@color/brand_primary" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Dinner"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/inter"
                                        android:textColor="@color/text_caption" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <TextView
                                        android:id="@+id/text_dinner_in_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:fontFamily="@font/poppins"
                                        android:textStyle="bold"
                                        android:textColor="@color/state_success" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" / "
                                        android:textSize="16sp"
                                        android:fontFamily="@font/inter"
                                        android:textColor="@color/text_caption" />

                                    <TextView
                                        android:id="@+id/text_dinner_out_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="24sp"
                                        android:fontFamily="@font/poppins"
                                        android:textStyle="bold"
                                        android:textColor="@color/semantic_error" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="IN"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/inter"
                                        android:textStyle="bold"
                                        android:textColor="@color/state_success" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="   OUT"
                                        android:textSize="10sp"
                                        android:fontFamily="@font/inter"
                                        android:textStyle="bold"
                                        android:textColor="@color/semantic_error" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════ -->
                <!--   BREAKFAST SELECTIONS CARD    -->
                <!-- ═══════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    style="@style/Profound.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_rounded_card_surface"
                                android:backgroundTint="#E65100" />

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_rounded_card_surface"
                                android:backgroundTint="#FFF3E0"
                                android:layout_marginStart="12dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_breakfast_dining"
                                    app:tint="#E65100" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="BREAKFAST SELECTIONS"
                                    android:textSize="11sp"
                                    android:fontFamily="@font/inter"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_caption"
                                    android:letterSpacing="0.06" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Today's breakfast choices"
                                    android:textSize="12sp"
                                    android:fontFamily="@font/inter"
                                    android:textColor="@color/text_sub" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/neutral_100"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/text_breakfast_counts_breakdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No selections yet."
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.4"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/text_body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════ -->
                <!--   SUBSCRIPTION REQUESTS        -->
                <!-- ═══════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="12dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_rounded_card_surface"
                        android:backgroundTint="@color/brand_primary"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SUBSCRIPTION REQUESTS"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:textColor="@color/text_caption"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingBottom="20dp"
                    tools:listitem="@layout/item_student_request" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>