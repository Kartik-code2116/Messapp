rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable Helper: Gets current user's data once to save on billable reads
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Users: Only the owner can write their own doc; mess owners can update roles/subscriptions
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        getUserData().role == "MESS_OWNER"
      );
    }

    // Messes: Public read for guest browsing; only Mess Owners can create/edit messes
    match /messes/{messId} {
      allow read: if true;
      allow write: if request.auth != null && getUserData().role == "MESS_OWNER";
    }

    // Menus: Anyone authenticated can read; only Mess Owners can update menus
    match /menus/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == "MESS_OWNER";
    }

    // Mess settings: Authenticated read; only Mess Owners can edit settings
    match /mess_settings/{messId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == "MESS_OWNER";
    }

    // Meal selections: doc id format {messId}_{yyyy-MM-dd}_{userId}
    // Suffix match lets students read legacy docs missing the userId field (meal history)
    match /meal_selections/{docId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        docId.matches('.*_' + request.auth.uid + '$') ||
        getUserData().role == "MESS_OWNER"
      );
      allow write: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        getUserData().role == "MESS_OWNER"
      );
    }

    // Subscriptions & Requests: Authenticated access
    match /subscriptions/{subId} {
      allow read, write: if request.auth != null;
    }

    match /subscriptionRequests/{reqId} {
      allow read, write: if request.auth != null;
    }

    // Mess notifications: Authenticated users can read; only Mess Owners publish notifications
    match /mess_notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == "MESS_OWNER";
    }

    // Transactions: Immutable financial ledger — create only, never update/delete
    match /transactions/{txnId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        getUserData().role == "MESS_OWNER"
      );
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Reviews: Students manage their own; mess owners read reviews for their mess only
    match /reviews/{reviewId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (getUserData().role == "MESS_OWNER" && getUserData().messId == resource.data.messId)
      );
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Offers & Campaigns: Authenticated read; only Mess Owners can manage; students can update usageCount
    match /offers/{offerId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && getUserData().role == "MESS_OWNER";
      allow update: if request.auth != null && (
        getUserData().role == "MESS_OWNER" ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount'])
      );
    }

    // Analytics Events: Write-only ledger for user activity tracking
    match /analytics_events/{eventId} {
      allow read: if request.auth != null && getUserData().role == "MESS_OWNER";
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Notification Events: Log of pushed notification metrics
    match /notification_events/{eventId} {
      allow read: if request.auth != null && getUserData().role == "MESS_OWNER";
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Notification Preferences: Users manage their own preferences
    match /notification_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
